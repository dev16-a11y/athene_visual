    "verify:motion": "node scripts/motion-check.mjs",
    "smoke:signalr": "node scripts/signalr-smoke.mjs",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "8.56.2",
    "@microsoft/signalr": "9.0.19",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
