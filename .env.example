# Smarttwin — демонстрационное окружение.
# Скопируйте файл в .env и замените пароль перед развёртыванием.
POSTGRES_DB=smarttwin
POSTGRES_USER=smarttwin
POSTGRES_PASSWORD=smarttwin
POSTGRES_PORT=5433

API_PORT=5080
WEB_PORT=8080
TZ=Europe/Moscow

# Клиент вне Docker (npm run dev) использует прокси Vite на этот адрес.
VITE_DEV_API_TARGET=http://localhost:5080

# Если клиент собирается отдельно и обращается к API по другому адресу:
# VITE_API_BASE=https://smarttwin.example.local
